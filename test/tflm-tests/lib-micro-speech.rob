  -128, -128, -128, -128, -128, -128, -128, -128, -128, -128, -128, -128, -128, -128, -128, -128, -77, -128, -128, -128
};

tensor_arena = {0u:12288}; // 12KB

required_kernels = {
    22, // KERNELS.RESHAPE
    9,  // KERNELS.FULLY_CONNECTED
    4, // KERNELS.DEPTHWISE_CONV_2D
    25  // KERNELS.SOFTMAX
};

int8 test_infer_yes() {
    h = InitializeInterpreter(micro_speech_model_data, tensor_arena, required_kernels);
    if(h == 0) { return 1; } 

    in = GetInputTensor(h, 0);
    out = GetOutputTensor(h, 0);
    if(in == 0 or out == 0) {
        DestroyInterpreter(h);
        return 2; 
    }

    output = {0.0, 0.0, 0.0, 0.0};
    
    SetTensorFromIntArray(in, dados_yes_input, 1960);

    InvokeInterpreter(h);
    GetTensorArray(out, output, 4);
    DestroyInterpreter(h);


    // Verifica se o índice 2 ("yes") é o maior
    if (output[2] > output[0] and output[2] > output[1] and output[2] > output[3]) {
        return 0; // SUCESSO
    } else {
        return 3; // Falha na lógica
    }

    return 0;
}

int8 test_infer_no() {
    h = InitializeInterpreter(micro_speech_model_data, tensor_arena, required_kernels);
    if(h == 0) { return 1; }

    in = GetInputTensor(h, 0);
    out = GetOutputTensor(h, 0);
    if(in == 0 or out == 0) {
        DestroyInterpreter(h);
        return 2;
    }

    output = {0.0, 0.0, 0.0, 0.0}; 
    
    SetTensorFromIntArray(in, dados_no_input, 1960);

    InvokeInterpreter(h);
    GetTensorArray(out, output, 4);
    DestroyInterpreter(h);

    // Verifica se o índice 3 ("no") é o maior
    if (output[3] > output[0] and output[3] > output[1] and output[3] > output[2]) {
        return 0; // SUCESSO
    } else {
        return 4; // Falha na lógica
    }
}

int8 test_infer_silence() {
    h = InitializeInterpreter(micro_speech_model_data, tensor_arena, required_kernels);
    if(h == 0) { return 1; }

    in = GetInputTensor(h, 0);
    out = GetOutputTensor(h, 0);
    if(in == 0 or out == 0) {
        DestroyInterpreter(h);
        return 2;
    }
    
    output = {0.0, 0.0, 0.0, 0.0}; 

    // Passa os dados de silêncio
    SetTensorFromIntArray(in, dados_silence_input, 1960);
    InvokeInterpreter(h);
    GetTensorArray(out, output, 4);
    DestroyInterpreter(h);

    // O índice para silence é 0 [silence, unknown, yes, no]
    if (output[0] > output[1] and output[0] > output[2] and output[0] > output[3]) {
        return 0; // SUCESSO
    } else {
        return 5; // Erro de lógica para silence
    }
}

int8 main() {
    result = 0;
    
    res_yes = test_infer_yes();
    if(res_yes != 0) {
        PrintFloat(float(res_yes)); 
        return res_yes;
    }

    res_no = test_infer_no();
    if(res_no != 0) {
        PrintFloat(float(res_no)); 
        return res_no;
    }

    res_silence = test_infer_silence();
    if(res_silence != 0) {
        PrintFloat(float(res_silence));
        return res_silence;
    }

    PrintFloat(float(result)); 
    return result;
}
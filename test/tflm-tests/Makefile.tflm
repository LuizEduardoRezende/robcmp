# Makefile simples para rob + TensorFlow Lite Micro

# Nome base do arquivo (sem extensão)
BASE_NAME = hello-world-test

# Configurações
ROB_FILE = ../test/tflm-tests/$(BASE_NAME).rob
OBJ_FILE = $(BASE_NAME).o
EXE_FILE = $(BASE_NAME)

# Ferramentas e bibliotecas
ROBCMP = ./robcmp
CLANG = clang++
WRAPPER_LIB = libtflm_wrapper_static.a
TFLM_LIB = ../third-party/tflite-micro/gen/linux_x86_64_default_gcc/lib/libtensorflow-microlite.a

# Target padrão
all: $(EXE_FILE)

# Compila .rob para .o
$(OBJ_FILE): $(ROB_FILE)
	$(ROBCMP) $(ROB_FILE) -I ../lib -o $(OBJ_FILE)

# Linka .o com bibliotecas
$(EXE_FILE): $(OBJ_FILE)
	$(CLANG) $(OBJ_FILE) $(WRAPPER_LIB) $(TFLM_LIB) -o $(EXE_FILE) -lstdc++

# Executa o programa
run: $(EXE_FILE)
	./$(EXE_FILE)

# Limpeza
clean:
	rm -f $(OBJ_FILE) $(EXE_FILE)

.PHONY: all run clean
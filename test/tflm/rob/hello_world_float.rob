/*
 * Camada 2 da validação: o caminho real de ponta a ponta.
 *
 *   programa RL -> robcmp -> link com o wrapper e o TFLM -> execução
 *
 * Os bytes do modelo são inseridos no lugar do marcador abaixo por
 * tflite_to_rob.py, durante o build (make rob). Devolve 0 se tudo passar, ou o
 * número da etapa que falhou.
 */
use ai.tflm;

// @MODELO@

arena = {0u:3000};

int8 main() {
    r = tflm_create_resolver();
    if r == 0 {
        return 1;
    }
    if tflm_add_fully_connected(r) != 0 {
        return 2;
    }

    m = tflm_create_model(r, modelo, arena);
    if m == 0 {
        return 3;
    }

    entrada = GetInputTensor(m, 0);
    saida = GetOutputTensor(m, 0);

    // sin(1.57) ~ 1.0
    SetTensorValue(entrada, 0, 1.57);
    if InvokeInterpreter(m) != 0 {
        return 4;
    }
    y = GetTensorAsFloat(saida, 0);
    PrintFloat(y);
    if y < 0.75 or y > 1.25 {
        return 5;
    }

    // sin(0) ~ 0.0
    SetTensorValue(entrada, 0, 0.0);
    if InvokeInterpreter(m) != 0 {
        return 6;
    }
    y0 = GetTensorAsFloat(saida, 0);
    PrintFloat(y0);
    if y0 < -0.25 or y0 > 0.25 {
        return 7;
    }

    tflm_free_model(m);
    return 0;
}

use ai.tflm;

// Dados simulados de um modelo simples (normalmente seria um arquivo model_data.h)
mock_model_data = {0x1C, 0x00, 0x00, 0x00, 0x54, 0x46, 0x4C, 0x33};

// Arena de memória para tensores (2KB)
tensor_arena = {0u:2048};

// Lista de kernels necessários para este teste
required_kernels = {33, 34, 79};

int8 test_tflm_initialization(){
    // Teste 1: Inicialização com kernels específicos
    interpreter_handle = InitializeInterpreter(mock_model_data, tensor_arena, 2048, required_kernels);
    
    if(interpreter_handle == 0) {
        return -1; // Falha na inicialização
    }
    
    // Teste 2: Obter tensor de entrada
    input_tensor = GetInputTensor(interpreter_handle, 0);
    if(input_tensor == 0) {
        DestroyInterpreter(interpreter_handle);
        return -2; // Falha ao obter tensor de entrada
    }
    
    // Teste 3: Obter tensor de saída
    output_tensor = GetOutputTensor(interpreter_handle, 0);
    if(output_tensor == 0) {
        DestroyInterpreter(interpreter_handle);
        return -3; // Falha ao obter tensor de saída
    }
    
    // Teste 4: Executar inferência
    InvokeInterpreter(interpreter_handle);
    
    // Teste 5: Limpeza
    DestroyInterpreter(interpreter_handle);
    
    return 1; // Sucesso
}

int8 test_tflm_auto_initialization(){
    // Teste de inicialização automática (sem especificar kernels)
    interpreter_handle = InitializeInterpreterAuto(mock_model_data, tensor_arena, 2048);
    
    if(interpreter_handle == 0) {
        return -1; // Falha na inicialização automática
    }
    
    // Executar uma inferência simples
    InvokeInterpreter(interpreter_handle);
    
    // Limpeza
    DestroyInterpreter(interpreter_handle);
    
    return 1; // Sucesso
}

int8 test_tflm_benchmark(){
    // Teste de benchmark com 10 execuções
    benchmark_result = RunBenchmarkOptimized(mock_model_data, tensor_arena, 2048, 10);
    
    if(benchmark_result == 0) {
        return -1; // Falha no benchmark
    }
    
    return 1; // Sucesso
}

int8 main(){

    // Executar teste de inicialização básica
    result = test_tflm_initialization();
    if(result != 1) {
        return result; // Retorna código de erro
    }
    
    // Executar teste de inicialização automática
    result = test_tflm_auto_initialization();
    if(result != 1) {
        return result + 10; // Offset para distinguir erros
    }
    
    // Executar teste de benchmark
    result = test_tflm_benchmark();
    if(result != 1) {
        return result + 20; // Offset para distinguir erros
    }
    
    return 0; // Todos os testes passaram
}


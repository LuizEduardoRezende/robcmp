int8 tflm_add_pcan(uint64 resolver_handle);
int8 tflm_add_rfft(uint64 resolver_handle);
int8 tflm_add_stacker(uint64 resolver_handle);
int8 tflm_add_window(uint64 resolver_handle);


// ---------------------------------------------------------------------------
// Registro de kernels -- outros custom ops
// ---------------------------------------------------------------------------


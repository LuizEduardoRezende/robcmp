// ---------------------------------------------------------------------------
// Acesso aos tensores
//
// Cada tensor tem duas visões, como na sintaxe nativa:
//
//   valores reais  tflm_set_value/values, tflm_get_value/values
//                  conversão automática com o scale e o zero_point do modelo:
//                  q = round(v/scale) + zero_point  e  v = scale * (q - zero_point)
//
//   códigos crus   tflm_set_raw_*, tflm_get_raw_*
//                  sem conversão, para dados que já estão na representação do
//                  modelo: a saída de um modelo que alimenta outro, ou dados de
//                  sensor já em int8
//
// Correspondência com a sintaxe nativa (test/tflm/native-syntax.rob), em que
// cada tensor é um membro do modelo com o número no nome, a partir de 0:
//
//   tflm_create_resolver(),
//   tflm_add_*(r) por kernel,
//   tflm_create_model(r, ...)   m = ai_model("modelo.tflite", arena)
//   tflm_invoke(m)              m.invoke()
//   tflm_free_model(m)          sem equivalente: não há destruição
//   tflm_input(m, 0)            m.input0
//   tflm_output(m, 1)           m.output1
//   tflm_input_count(m)         m.input_count
//   tflm_output_count(m)        m.output_count
//   tflm_tensor_size(t)         m.input0.size
//   tflm_set_values(t, v)       m.input0 = v
//   tflm_get_values(t, v)       v = m.output0
//   tflm_set_value(t, j, x)     m.input0[j] = x
//   tflm_get_value(t, j)        x = m.output0[j]
//   tflm_set_raw_int8(t, v)     m.input0.raw = v
//   tflm_get_raw_int8(t, v)     v = m.output0.raw
//
// Na sintaxe nativa, os kernels, os contadores, o tamanho, o scale e o
// zero_point vêm do .tflite em tempo de compilação: viram constantes, não
// chamadas.
// ---------------------------------------------------------------------------

// Tensor de entrada ou de saída de índice `index`. Devolve 0 se o índice não
// existir no modelo.
uint64 tflm_input(uint64 model_handle, uint64 index);
uint64 tflm_output(uint64 model_handle, uint64 index);

// Quantidade de tensores de entrada e de saída do modelo.
uint64 tflm_input_count(uint64 model_handle);
uint64 tflm_output_count(uint64 model_handle);

// Número de elementos do tensor.
uint64 tflm_tensor_size(uint64 tensor_handle);


// Valores reais, um elemento. Índice fora do tensor: a escrita é ignorada e a
// leitura devolve 0.
void tflm_set_value(uint64 tensor_handle, uint64 index, float value);
float tflm_get_value(uint64 tensor_handle, uint64 index);

// Valores reais, o tensor inteiro. O vetor precisa ter exatamente o número de
// elementos do tensor. Retorno: 0 = copiado, -1 = recusado, sem copiar nada.
int8 tflm_set_values(uint64 tensor_handle, float[] values);
int8 tflm_get_values(uint64 tensor_handle, float[] values);


// Códigos crus, o tensor inteiro. O tipo do vetor precisa ser o do tensor
// (int8[] para tensor int8, int16[] para tensor int16) e o vetor precisa ter
// exatamente o número de elementos do tensor.
// Retorno: 0 = copiado, -1 = recusado, sem copiar nada.
int8 tflm_set_raw_int8(uint64 tensor_handle, int8[] values);
int8 tflm_get_raw_int8(uint64 tensor_handle, int8[] values);
int8 tflm_set_raw_int16(uint64 tensor_handle, int16[] values);
int8 tflm_get_raw_int16(uint64 tensor_handle, int16[] values);


// ---------------------------------------------------------------------------
// Utilitário
// ---------------------------------------------------------------------------

void tflm_print_float(float value);

int8 main(){
    return 0;
}

/*
 * ai.tflm -- biblioteca padrão de inferência TinyML da Robotics Language.
 *
 * Declara (não implementa) as funções do wrapper C. A implementação vive na
 * biblioteca estática do wrapper; a resolução acontece na linkedição.
 *
 * Uso:  use ai.tflm;
 *
 * ---------------------------------------------------------------------------
 * MUDANÇA EM RELAÇÃO À VERSÃO DO TCC
 *
 * Antes, os kernels eram informados por um vetor de números em runtime:
 *
 *     const required_kernels = {9};          // 9 = FULLY_CONNECTED
 *     h = InitializeInterpreter(modelo, arena, required_kernels);
 *
 * Agora cada kernel é uma chamada própria, entre a criação do resolver e a do
 * modelo:
 *
 *     r = tflm_create_resolver();
 *     tflm_add_fully_connected(r);
 *     h = tflm_create_model(r, modelo, arena);
 *
 * O código fica auto-explicativo -- some o número mágico -- e o binário passa
 * a conter apenas os kernels chamados: cada um é um símbolo independente, e o
 * linker descarta os demais com --gc-sections, sem configuração manual.
 *
 * É também exatamente o que o compilador emite para a sintaxe nativa. Os dois
 * modos são o mesmo mecanismo; a sintaxe nativa apenas dispensa você de
 * escrever estas chamadas.
 *
 * Para descobrir quais kernels um modelo exige:
 *
 *     ./test/tflm/tflite_info seu_modelo.tflite
 * ---------------------------------------------------------------------------
 */


// ---------------------------------------------------------------------------
// Ciclo de vida do modelo
// ---------------------------------------------------------------------------

// Reserva uma instância. Devolve o handle do resolver, ou 0 se não houver slot.
uint64 tflm_create_resolver();

// Constrói o interpretador e aloca os tensores na arena. Devolve o handle do
// modelo, ou 0 em caso de erro.
uint64 tflm_create_model(uint64 resolver_handle, uint8[] model_data, uint8[] tensor_arena);

// Libera a instância para reuso. Não devolve memória: não há heap.
void tflm_free_model(uint64 handle);


// ---------------------------------------------------------------------------
// Execução
// ---------------------------------------------------------------------------

// Executa a inferência. Devolve 0 em caso de sucesso, -1 em caso de falha.
int8 tflm_invoke(uint64 model_handle);


// ---------------------------------------------------------------------------
// Registro de kernels -- operadores builtin
//
// Chame, entre tflm_create_resolver e tflm_create_model, uma função para cada
// kernel que o modelo usa. Retorno: 0 = registrado, -1 = falha.

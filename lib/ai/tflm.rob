// TODO(b/160234179): Change custom OPs to also return by value.
// TODO(b/230666079): resolve conflict with xtensa implementation


// Inicialização com kernels específicos
uint32 InitializeInterpreter(uint8[] model_data, uint8[] tensor_arena, uint32 tensor_arena_size, uint8[] required_kernels);

// Inicialização com detecção automática de kernels
uint32 InitializeInterpreterAuto(uint8[] model_data, uint8[] tensor_arena, uint32 tensor_arena_size);

// Destruição e limpeza
void DestroyInterpreter(uint32 instance_handle);

// Acesso aos tensores
uint32 GetInputTensor(uint32 instance_handle, uint32 index);
uint32 GetOutputTensor(uint32 instance_handle, uint32 index);

// Execução de inferência
void InvokeInterpreter(uint32 instance_handle);

/* Funções de análise e benchmark */

// Executa benchmark otimizado
uint32 RunBenchmarkOptimized(uint8[] model_data, uint8[] tensor_arena, uint32 tensor_arena_size, uint32 num_invocations);


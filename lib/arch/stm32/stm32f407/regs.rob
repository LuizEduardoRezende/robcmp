/* Types and registers for RCC 
  Reset and clock control
 */

 type RCC_CR_t {
	HSION     = false;              // Internal high-speed clock enable
	HSIRDY    = false;              // Internal high-speed clock ready flag
	_res1     = false;              // Reserved, 1 bits
	HSITRIM   = uint5(0);           // Internal high-speed clock trimming
	HSICAL    = uint8(0);           // Internal high-speed clock calibration
	HSEON     = false;              // HSE clock enable
	HSERDY    = false;              // HSE clock ready flag
	HSEBYP    = false;              // HSE clock bypass
	CSSON     = false;              // Clock security system enable
	_res2     = uint4(0);           // Reserved, 4 bits
	PLLON     = false;              // Main PLL (PLL) enable
	PLLRDY    = false;              // Main PLL (PLL) clock ready flag
	PLLI2SON  = false;              // PLLI2S enable
	PLLI2SRDY = false;              // PLLI2S clock ready flag
	_res3     = uint4(0);           // Reserved, 4 bits
 }

 // clock control register
 register RCC_CR_t RCC_CR at 0x40023800;
 register uint32 RCC_CR_raw at 0x40023800;

 type PLLCFGR_t {
	PLLM0  = false;              // Division factor for the main PLL (PLL) and audio PLL (PLLI2S) input clock
	PLLM1  = false;              // Division factor for the main PLL (PLL) and audio PLL (PLLI2S) input clock
	PLLM2  = false;              // Division factor for the main PLL (PLL) and audio PLL (PLLI2S) input clock
	PLLM3  = false;              // Division factor for the main PLL (PLL) and audio PLL (PLLI2S) input clock
	PLLM4  = false;              // Division factor for the main PLL (PLL) and audio PLL (PLLI2S) input clock
	PLLM5  = false;              // Division factor for the main PLL (PLL) and audio PLL (PLLI2S) input clock
	PLLN0  = false;              // Main PLL (PLL) multiplication factor for VCO
	PLLN1  = false;              // Main PLL (PLL) multiplication factor for VCO
	PLLN2  = false;              // Main PLL (PLL) multiplication factor for VCO
	PLLN3  = false;              // Main PLL (PLL) multiplication factor for VCO
	PLLN4  = false;              // Main PLL (PLL) multiplication factor for VCO
	PLLN5  = false;              // Main PLL (PLL) multiplication factor for VCO
	PLLN6  = false;              // Main PLL (PLL) multiplication factor for VCO
	PLLN7  = false;              // Main PLL (PLL) multiplication factor for VCO
	PLLN8  = false;              // Main PLL (PLL) multiplication factor for VCO
	_res1  = false;              // Reserved, 1 bits
	PLLP0  = false;              // Main PLL (PLL) division factor for main system clock
	PLLP1  = false;              // Main PLL (PLL) division factor for main system clock
	_res2  = uint4(0);           // Reserved, 4 bits
	PLLSRC = false;              // Main PLL(PLL) and audio PLL (PLLI2S) entry clock source
	_res3  = false;              // Reserved, 1 bits
	PLLQ0  = false;              // Main PLL (PLL) division factor for USB OTG FS, SDIO and random number generator clocks
	PLLQ1  = false;              // Main PLL (PLL) division factor for USB OTG FS, SDIO and random number generator clocks
	PLLQ2  = false;              // Main PLL (PLL) division factor for USB OTG FS, SDIO and random number generator clocks
	PLLQ3  = false;              // Main PLL (PLL) division factor for USB OTG FS, SDIO and random number generator clocks
	_res4  = uint4(0);           // Reserved, 4 bits
 }

 // PLL configuration register
 register PLLCFGR_t PLLCFGR at 0x40023804;
 register uint32 PLLCFGR_raw at 0x40023804;

 type CFGR_t {
	SW0     = false;              // System clock switch
	SW1     = false;              // System clock switch
	SWS0    = false;              // System clock switch status
	SWS1    = false;              // System clock switch status
	HPRE    = uint4(0);           // AHB prescaler
	_res1   = uint2(0);           // Reserved, 2 bits
	PPRE1   = uint3(0);           // APB Low speed prescaler (APB1)
	PPRE2   = uint3(0);           // APB high-speed prescaler (APB2)
	RTCPRE  = uint5(0);           // HSE division factor for RTC clock
	MCO1    = uint2(0);           // Microcontroller clock output 1
	I2SSRC  = false;              // I2S clock selection
	MCO1PRE = uint3(0);           // MCO1 prescaler
	MCO2PRE = uint3(0);           // MCO2 prescaler
	MCO2    = uint2(0);           // Microcontroller clock output 2
 }


	SQ4   = uint5(0);           // 4th conversion in regular sequence
	SQ5   = uint5(0);           // 5th conversion in regular sequence
	SQ6   = uint5(0);           // 6th conversion in regular sequence
	_res1 = uint2(0);           // Reserved, 2 bits
 }


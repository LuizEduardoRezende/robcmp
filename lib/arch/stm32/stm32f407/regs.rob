/* Types and registers for DAC 
  Digital-to-analog converter
 */

 type DAC_CR_t {
	EN1       = false;              // DAC channel1 enable
	BOFF1     = false;              // DAC channel1 output buffer disable
	TEN1      = false;              // DAC channel1 trigger enable
	TSEL1     = uint3(0);           // DAC channel1 trigger selection
	WAVE1     = uint2(0);           // DAC channel1 noise/triangle wave generation enable
	MAMP1     = uint4(0);           // DAC channel1 mask/amplitude selector
	DMAEN1    = false;              // DAC channel1 DMA enable
	DMAUDRIE1 = false;              // DAC channel1 DMA Underrun Interrupt enable
	_res1     = uint2(0);           // Reserved, 2 bits
	EN2       = false;              // DAC channel2 enable
	BOFF2     = false;              // DAC channel2 output buffer disable
	TEN2      = false;              // DAC channel2 trigger enable

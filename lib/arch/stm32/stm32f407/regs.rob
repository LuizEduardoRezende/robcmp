	WAVE2     = uint2(0);           // DAC channel2 noise/triangle wave generation enable
	MAMP2     = uint4(0);           // DAC channel2 mask/amplitude selector
	DMAEN2    = false;              // DAC channel2 DMA enable
	DMAUDRIE2 = false;              // DAC channel2 DMA underrun interrupt enable
	_res2     = uint2(0);           // Reserved, 2 bits
 }


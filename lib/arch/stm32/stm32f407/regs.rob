/* Types and registers for FLASH 
  FLASH
 */

 type ACR_t {
	LATENCY = uint3(0);           // Latency
	_res1   = uint5(0);           // Reserved, 5 bits
	PRFTEN  = false;              // Prefetch enable
	ICEN    = false;              // Instruction cache enable
	DCEN    = false;              // Data cache enable
	ICRST   = false;              // Instruction cache reset
	DCRST   = false;              // Data cache reset
	_res2   = uint19(0);          // Reserved, 19 bits
 }

 // Flash access control register
 register ACR_t ACR at 0x40023c00;
 register uint32 ACR_raw at 0x40023c00;

 type KEYR_t {
	KEY = uint32(0);          // FPEC key
 }

 // Flash key register
 register KEYR_t KEYR at 0x40023c04;
 register uint32 KEYR_raw at 0x40023c04;

 type OPTKEYR_t {
	OPTKEY = uint32(0);          // Option byte key
 }

 // Flash option key register
 register OPTKEYR_t OPTKEYR at 0x40023c08;
 register uint32 OPTKEYR_raw at 0x40023c08;

 type FLASH_SR_t {
	EOP    = false;              // End of operation
	OPERR  = false;              // Operation error
	_res1  = uint2(0);           // Reserved, 2 bits
	WRPERR = false;              // Write protection error
	PGAERR = false;              // Programming alignment error
	PGPERR = false;              // Programming parallelism error
	PGSERR = false;              // Programming sequence error
	_res2  = uint8(0);           // Reserved, 8 bits
	BSY    = false;              // Busy
	_res3  = uint15(0);          // Reserved, 15 bits
 }

 // Status register
 register FLASH_SR_t FLASH_SR at 0x40023c0c;
 register uint32 FLASH_SR_raw at 0x40023c0c;

 type FLASH_CR_t {
	PG    = false;              // Programming
	SER   = false;              // Sector Erase
	MER   = false;              // Mass Erase
	SNB   = uint4(0);           // Sector number
	_res1 = false;              // Reserved, 1 bits
	PSIZE = uint2(0);           // Program size
	_res2 = uint6(0);           // Reserved, 6 bits
	STRT  = false;              // Start
	_res3 = uint7(0);           // Reserved, 7 bits
	EOPIE = false;              // End of operation interrupt enable
	ERRIE = false;              // Error interrupt enable
	_res4 = uint5(0);           // Reserved, 5 bits
	LOCK  = false;              // Lock
 }

 // Control register
 register FLASH_CR_t FLASH_CR at 0x40023c10;
 register uint32 FLASH_CR_raw at 0x40023c10;

 type OPTCR_t {
	OPTLOCK    = false;              // Option lock
	OPTSTRT    = false;              // Option start
	BOR_LEV    = uint2(0);           // BOR reset Level
	_res1      = false;              // Reserved, 1 bits
	WDG_SW     = false;              // WDG_SW User option bytes
	nRST_STOP  = false;              // nRST_STOP User option bytes
	nRST_STDBY = false;              // nRST_STDBY User option bytes
	RDP        = uint8(0);           // Read protect
	nWRP       = uint12(0);          // Not write protect
	_res2      = uint4(0);           // Reserved, 4 bits
 }

 // Flash option control register
 register OPTCR_t OPTCR at 0x40023c14;
 register uint32 OPTCR_raw at 0x40023c14;



	DDS     = false;              // DMA disable selection for multi-ADC mode
	DMA     = uint2(0);           // Direct memory access mode for multi ADC mode
	ADCPRE  = uint2(0);           // ADC prescaler
	_res3   = uint4(0);           // Reserved, 4 bits
	VBATE   = false;              // VBAT enable
	TSVREFE = false;              // Temperature sensor and VREFINT enable
	_res4   = uint8(0);           // Reserved, 8 bits

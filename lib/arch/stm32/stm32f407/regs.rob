	AWD3   = false;              // Analog watchdog flag of ADC 3
	EOC3   = false;              // End of conversion of ADC 3
	JEOC3  = false;              // Injected channel end of conversion of ADC 3
	JSTRT3 = false;              // Injected channel Start flag of ADC 3
	STRT3  = false;              // Regular channel Start flag of ADC 3
	OVR3   = false;              // Overrun flag of ADC3
	_res3  = uint10(0);          // Reserved, 10 bits
 }


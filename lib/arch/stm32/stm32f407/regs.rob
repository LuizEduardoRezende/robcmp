/* Types and registers for TIM5 
  General-purpose-timers
 */

 type TIM5_CR1_t {
	CEN   = false;              // Counter enable
	UDIS  = false;              // Update disable
	URS   = false;              // Update request source
	OPM   = false;              // One-pulse mode
	DIR   = false;              // Direction
	CMS   = uint2(0);           // Center-aligned mode selection
	ARPE  = false;              // Auto-reload preload enable
	CKD   = uint2(0);           // Clock division
	_res1 = uint22(0);          // Reserved, 22 bits
 }

 // control register 1
 register TIM5_CR1_t TIM5_CR1 at 0x40000c00;
 register uint32 TIM5_CR1_raw at 0x40000c00;

 type TIM5_CR2_t {
	_res1 = uint3(0);           // Reserved, 3 bits
	CCDS  = false;              // Capture/compare DMA selection
	MMS   = uint3(0);           // Master mode selection
	TI1S  = false;              // TI1 selection
	_res2 = uint24(0);          // Reserved, 24 bits
 }

 // control register 2
 register TIM5_CR2_t TIM5_CR2 at 0x40000c04;
 register uint32 TIM5_CR2_raw at 0x40000c04;

 type TIM5_SMCR_t {
	SMS   = uint3(0);           // Slave mode selection
	_res1 = false;              // Reserved, 1 bits
	TS    = uint3(0);           // Trigger selection
	MSM   = false;              // Master/Slave mode
	ETF   = uint4(0);           // External trigger filter
	ETPS  = uint2(0);           // External trigger prescaler
	ECE   = false;              // External clock enable
	ETP   = false;              // External trigger polarity
	_res2 = uint16(0);          // Reserved, 16 bits
 }

 // slave mode control register
 register TIM5_SMCR_t TIM5_SMCR at 0x40000c08;
 register uint32 TIM5_SMCR_raw at 0x40000c08;

 type TIM5_DIER_t {
	UIE   = false;              // Update interrupt enable
	CC1IE = false;              // Capture/Compare 1 interrupt enable
	CC2IE = false;              // Capture/Compare 2 interrupt enable
	CC3IE = false;              // Capture/Compare 3 interrupt enable
	CC4IE = false;              // Capture/Compare 4 interrupt enable
	_res1 = false;              // Reserved, 1 bits
	TIE   = false;              // Trigger interrupt enable
	_res2 = false;              // Reserved, 1 bits
	UDE   = false;              // Update DMA request enable
	CC1DE = false;              // Capture/Compare 1 DMA request enable
	CC2DE = false;              // Capture/Compare 2 DMA request enable
	CC3DE = false;              // Capture/Compare 3 DMA request enable
	CC4DE = false;              // Capture/Compare 4 DMA request enable
	_res3 = false;              // Reserved, 1 bits
	TDE   = false;              // Trigger DMA request enable
	_res4 = uint17(0);          // Reserved, 17 bits
 }

 // DMA/Interrupt enable register
 register TIM5_DIER_t TIM5_DIER at 0x40000c0c;
 register uint32 TIM5_DIER_raw at 0x40000c0c;


/* Types and registers for PWR 
  Power control
 */

 type PWR_CR_t {
	LPDS  = false;              // Low-power deep sleep
	PDDS  = false;              // Power down deepsleep
	CWUF  = false;              // Clear wakeup flag
	CSBF  = false;              // Clear standby flag
	PVDE  = false;              // Power voltage detector enable
	PLS   = uint3(0);           // PVD level selection
	DBP   = false;              // Disable backup domain write protection
	FPDS  = false;              // Flash power down in Stop mode
	_res1 = uint22(0);          // Reserved, 22 bits
 }

 // power control register
 register PWR_CR_t PWR_CR at 0x40007000;

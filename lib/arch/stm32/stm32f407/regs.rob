	BRR    = false;              // Backup regulator ready
	_res1  = uint4(0);           // Reserved, 4 bits
	EWUP   = false;              // Enable WKUP pin
	BRE    = false;              // Backup regulator enable
	_res2  = uint4(0);           // Reserved, 4 bits
	VOSRDY = false;              // Regulator voltage scaling output selection ready bit
	_res3  = uint17(0);          // Reserved, 17 bits
 }

 // power control/status register

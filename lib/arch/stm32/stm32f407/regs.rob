	XFRCM   = false;              // Transfer completed interrupt mask
	EPDM    = false;              // Endpoint disabled interrupt mask
	_res1   = false;              // Reserved, 1 bits
	STUPM   = false;              // SETUP phase done mask
	OTEPDM  = false;              // OUT token received when endpoint disabled mask
	_res2   = false;              // Reserved, 1 bits
	B2BSTUP = false;              // Back-to-back SETUP packets received mask
	_res3   = false;              // Reserved, 1 bits
	OPEM    = false;              // OUT packet error mask
	BOIM    = false;              // BNA interrupt mask
	_res4   = uint22(0);          // Reserved, 22 bits
 }


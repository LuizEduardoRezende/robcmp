/* Types and registers for OTG_HS_DEVICE 
  USB on the go high speed
 */

 type OTG_HS_DCFG_t {
	DSPD      = uint2(0);           // Device speed
	NZLSOHSK  = false;              // Nonzero-length status OUT handshake
	_res1     = false;              // Reserved, 1 bits
	DAD       = uint7(0);           // Device address
	PFIVL     = uint2(0);           // Periodic (micro)frame interval
	_res2     = uint11(0);          // Reserved, 11 bits
	PERSCHIVL = uint2(0);           // Periodic scheduling interval
	_res3     = uint6(0);           // Reserved, 6 bits
 }

 // OTG_HS device configuration register
 register OTG_HS_DCFG_t OTG_HS_DCFG at 0x40040800;
 register uint32 OTG_HS_DCFG_raw at 0x40040800;

 type OTG_HS_DCTL_t {
	RWUSIG   = false;              // Remote wakeup signaling
	SDIS     = false;              // Soft disconnect
	GINSTS   = false;              // Global IN NAK status
	GONSTS   = false;              // Global OUT NAK status
	TCTL     = uint3(0);           // Test control
	SGINAK   = false;              // Set global IN NAK
	CGINAK   = false;              // Clear global IN NAK
	SGONAK   = false;              // Set global OUT NAK
	CGONAK   = false;              // Clear global OUT NAK
	POPRGDNE = false;              // Power-on programming done
	_res1    = uint20(0);          // Reserved, 20 bits
 }

 // OTG_HS device control register
 register OTG_HS_DCTL_t OTG_HS_DCTL at 0x40040804;
 register uint32 OTG_HS_DCTL_raw at 0x40040804;

 type OTG_HS_DSTS_t {
	SUSPSTS = false;              // Suspend status
	ENUMSPD = uint2(0);           // Enumerated speed
	EERR    = false;              // Erratic error
	_res1   = uint4(0);           // Reserved, 4 bits
	FNSOF   = uint14(0);          // Frame number of the received SOF
	_res2   = uint10(0);          // Reserved, 10 bits
 }

 // OTG_HS device status register
 register OTG_HS_DSTS_t OTG_HS_DSTS at 0x40040808;
 register uint32 OTG_HS_DSTS_raw at 0x40040808;

 type OTG_HS_DIEPMSK_t {
	XFRCM     = false;              // Transfer completed interrupt mask
	EPDM      = false;              // Endpoint disabled interrupt mask
	_res1     = false;              // Reserved, 1 bits
	TOM       = false;              // Timeout condition mask (nonisochronous endpoints)
	ITTXFEMSK = false;              // IN token received when TxFIFO empty mask
	INEPNMM   = false;              // IN token received with EP mismatch mask
	INEPNEM   = false;              // IN endpoint NAK effective mask
	_res2     = false;              // Reserved, 1 bits
	TXFURM    = false;              // FIFO underrun mask
	BIM       = false;              // BNA interrupt mask
	_res3     = uint22(0);          // Reserved, 22 bits
 }


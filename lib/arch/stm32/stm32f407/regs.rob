	LSIRDYF     = false;              // LSI ready interrupt flag
	LSERDYF     = false;              // LSE ready interrupt flag
	HSIRDYF     = false;              // HSI ready interrupt flag
	HSERDYF     = false;              // HSE ready interrupt flag
	PLLRDYF     = false;              // Main PLL (PLL) ready interrupt flag
	PLLI2SRDYF  = false;              // PLLI2S ready interrupt flag

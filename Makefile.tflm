# Uso: make -f Makefile.tflm FILE=nome_do_arquivo
# Exemplo: make -f Makefile.tflm FILE=syntax-tests
#          make -f Makefile.tflm FILE=spam-model run
#          make -f Makefile.tflm FILE=syntax-tests clean

# Nome do arquivo (pode ser passado via linha de comando)
FILE ?= syntax-tests

# Validação: verificar se FILE foi definido
ifeq ($(FILE),)
$(error Erro: Defina o arquivo com FILE=nome. Exemplo: make FILE=syntax-tests)
endif

# Configurações automáticas
TEST_DIR = ../test/tflm-tests
ROB_FILE = $(TEST_DIR)/$(FILE).rob
OBJ_FILE = $(FILE).o
EXE_FILE = $(FILE)

# Ferramentas e bibliotecas
ROBCMP = ./robcmp
CLANG = clang++
WRAPPER_LIB = libtflm_wrapper_static.a
TFLM_LIB = ../third-party/tflite-micro/gen/linux_x86_64_default_gcc/lib/libtensorflow-microlite.a

# Verificações de dependências
REQUIRED_FILES = $(ROBCMP) $(WRAPPER_LIB) $(TFLM_LIB)

# Target padrão
all: $(EXE_FILE)
	@echo "   Sucesso! Executável '$(EXE_FILE)' criado."
	@echo "   Execute com: ./$(EXE_FILE) ou make FILE=$(FILE) run"

# Compila .rob para .o
$(OBJ_FILE): $(ROB_FILE)
	$(ROBCMP) $(ROB_FILE) -I ../lib -o $(OBJ_FILE)

# Linka .o com bibliotecas
$(EXE_FILE): $(OBJ_FILE)
	$(CLANG) $(OBJ_FILE) $(WRAPPER_LIB) $(TFLM_LIB) -o $(EXE_FILE) -lstdc++

# Executa o programa
run: $(EXE_FILE)
	./$(EXE_FILE)


# Limpeza específica do arquivo atual
clean:
	@echo "Limpando arquivos de $(FILE)..."
	rm -f $(OBJ_FILE) $(EXE_FILE)

# Limpeza completa (todos os arquivos .o e executáveis)
clean-all:
	@echo "Limpeza completa..."
	rm -f *.o
	@# Remove executáveis (arquivos sem extensão que não sejam diretórios)
	@find . -maxdepth 1 -type f -executable ! -name "*.*" ! -name "robcmp" ! -name "Makefile*" -delete 2>/dev/null || true
	@echo "Limpeza completa concluída."

# Help
help:
	@echo "  Makefile para rob + TensorFlow Lite Micro"
	@echo ""
	@echo "Uso:"
	@echo "  make FILE=nome_arquivo        # Compila o arquivo"
	@echo "  make FILE=nome_arquivo run    # Compila e executa"
	@echo "  make FILE=nome_arquivo clean  # Remove arquivos gerados"
	@echo ""
	@echo "Outros comandos:"
	@echo "  make clean-all                # Remove todos os .o e executáveis"
	@echo "  make help                     # Mostra esta ajuda"

.PHONY: all run clean clean-all help
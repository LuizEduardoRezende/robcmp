# Uso: make -f Makefile.tflm FILE=nome_do_arquivo
# Exemplo: make -f Makefile.tflm FILE=syntax-tests
#          make -f Makefile.tflm FILE=spam-model run
#          make -f Makefile.tflm FILE=syntax-tests clean

# Nome do arquivo (pode ser passado via linha de comando)
FILE ?= syntax-tests

# Validação: verificar se FILE foi definido
ifeq ($(FILE),)
$(error Erro: Defina o arquivo com FILE=nome. Exemplo: make FILE=syntax-tests)
endif

# Diretórios
ROOT_DIR := $(CURDIR)
BUILD_DIR := $(ROOT_DIR)/build
TEST_DIR := $(ROOT_DIR)/test/tflm-tests
THIRD_PARTY := $(ROOT_DIR)/third-party/tflite-micro

# Fontes e objetos
ROB_FILE := $(TEST_DIR)/$(FILE).rob
OBJ_FILE := $(BUILD_DIR)/$(FILE).o
EXE_FILE := $(BUILD_DIR)/$(FILE)

# Ferramentas e bibliotecas
ROBCMP := $(BUILD_DIR)/robcmp
CLANG := clang++
WRAPPER_LIB := $(BUILD_DIR)/libtflm_wrapper_static.a
TFLM_LIB := $(THIRD_PARTY)/gen/*/lib/libtensorflow-microlite.a

# Verificações de dependências
REQUIRED_FILES := $(ROBCMP) $(WRAPPER_LIB) $(TFLM_LIB)

# Target padrão
all: $(EXE_FILE)
	@echo "   Sucesso! Executável '$(EXE_FILE)' criado."
	@echo "   Execute com: $(EXE_FILE) ou make FILE=$(FILE) run"

# Garante que o diretório build existe
$(BUILD_DIR):
	@mkdir -p $(BUILD_DIR)

# Compila .rob para .o
$(OBJ_FILE): $(ROB_FILE) | $(BUILD_DIR)
	$(ROBCMP) $(ROB_FILE) -I $(ROOT_DIR)/lib -o $(OBJ_FILE)

# Linka .o com bibliotecas
$(EXE_FILE): $(OBJ_FILE)
	$(CLANG) $(OBJ_FILE) $(WRAPPER_LIB) $(TFLM_LIB) -o $(EXE_FILE) -lstdc++

# Executa o programa
run: $(EXE_FILE)
	$(EXE_FILE)

clean:
	@echo "Limpando arquivos de $(FILE)..."
	rm -f $(OBJ_FILE) $(EXE_FILE)

# Limpeza completa (todos os arquivos .o e executáveis)
clean-all:
	@echo "Limpeza completa..."
	rm -f $(BUILD_DIR)/*.o
	@echo "Limpeza completa concluída."

# Help
help:
	@echo "  Makefile para rob + TensorFlow Lite Micro"
	@echo ""
	@echo "Uso:"
	@echo "  make -f Makefile.tflm FILE=nome_arquivo        # Compila o arquivo"
	@echo "  make -f Makefile.tflm FILE=nome_arquivo run    # Compila e executa"
	@echo "  make -f Makefile.tflm FILE=nome_arquivo clean  # Remove arquivos gerados"
	@echo ""
	@echo "Outros comandos:"
	@echo "  make -f Makefile.tflm clean-all                # Remove todos os .o da build/"
	@echo "  make -f Makefile.tflm help                     # Mostra esta ajuda"

.PHONY: all run clean clean-all help